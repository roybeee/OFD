# /etc/systemd/system/ofd.service — systemd 유닛 예시
[Unit]
Description=OFD Franchise Workstation Server
After=network.target

[Service]
Type=simple
User=ofd
WorkingDirectory=/srv/ofd-workstation-server
Environment=PORT=8787
Environment=DB_PATH=/srv/ofd-workstation-server/data/ofd.db
Environment=SECURE_COOKIES=1
ExecStart=/usr/bin/node --no-warnings server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
