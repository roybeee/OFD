# OFD V2 local development defaults. Never commit real credentials.
NODE_ENV=development
APP_MODE=demo
REPOSITORY_MODE=memory
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4100
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Deployment identity. Render injects RENDER_GIT_COMMIT into RELEASE_SHA; do not invent a release id.
SERVICE_ROLE=
RELEASE_SHA=
# Reserved safety controls. The current application core does not enforce these; deployment preflight rejects non-empty values.
CUTOVER_STORE_IDS=
WRITE_FREEZE_STORE_IDS=

# PostgreSQL
POSTGRES_DB=ofd_v2
POSTGRES_USER=ofd
POSTGRES_PASSWORD=ofd-local-only
DATABASE_URL=postgresql://ofd:ofd-local-only@localhost:5432/ofd_v2
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Sessions/authentication. Never reuse example values; generate unique secrets per environment.
# SESSION_SECRET: openssl rand -base64 48
# ENCRYPTION_KEY: openssl rand -base64 32 (must decode to exactly 32 bytes)
SESSION_SECRET=
ENCRYPTION_KEY=
MFA_ISSUER="OFD Workstation"
SESSION_COOKIE_SECURE=false

# Object storage. Local demo defaults to mock; set STORAGE_MODE=s3 to exercise MinIO.
STORAGE_MODE=mock
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=ofd-v2-local
S3_ACCESS_KEY_ID=ofd-minio
S3_SECRET_ACCESS_KEY=ofd-minio-secret
S3_FORCE_PATH_STYLE=true
S3_KMS_KEY_ID=
UPLOAD_MAX_BYTES=10485760

# Outbox/worker
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=12
DOCUMENT_TIMEZONE=Asia/Seoul

# Email. Local development keeps delivery in mock mode; production requires smtp.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Popbill. Production issuance is fail-closed unless every gate below is valid.
PROVIDER_MODE=mock
POPBILL_PRODUCTION_ENABLED=false
POPBILL_TAX_INVOICE_ENABLED=false
POPBILL_BANK_SYNC_ENABLED=false
POPBILL_SMS_ENABLED=false
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_CORP_NUM=
POPBILL_USER_ID=
POPBILL_CERTIFICATE_CONFIGURED=false
POPBILL_BANK_ACCOUNT_AUTHORIZED=false
POPBILL_BANK_CODE=
POPBILL_BANK_ACCOUNT=
RECONCILIATION_ACCOUNT_ID=ofd-main
# Comma-separated YYYY-MM-DD dates. Required and validated in production; update annually before deployment.
KOREA_HOLIDAYS=2026-01-01,2026-03-01,2026-05-05,2026-08-15,2026-10-03,2026-10-09,2026-12-25
POPBILL_BANK_POLL_MS=1000
POPBILL_BANK_POLL_ATTEMPTS=120
POPBILL_SMS_SENDER=
POPBILL_WEBHOOK_API_KEY=

# Frontend
VITE_API_BASE=/api/v2
VITE_DEMO_MODE=false

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
