server {
  listen ${PORT};
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(self), geolocation=(), microphone=()" always;
  # 네이버 지도(매장 대장)는 외부 스크립트·타일·지오코딩 호출이 필요하다 — SDK(maps.js)가 실제 참조하는
  # 호스트(map/nrb/nrbe.map.naver.net, *.pstatic.net, nelo 텔레메트리)를 분석해 그 도메인만 정확히 허용
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.pstatic.net https://*.map.naver.net https://static.naver.net https://oapi.map.naver.com https://openapi.map.naver.com; connect-src 'self' https://*.pstatic.net https://*.map.naver.net https://oapi.map.naver.com https://openapi.map.naver.com https://naveropenapi.apigw.ntruss.com https://maps.apigw.ntruss.com https://kr-col-ext.nelo.navercorp.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://oapi.map.naver.com https://openapi.map.naver.com https://*.pstatic.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

  location /api/v2/ {
    proxy_pass http://${API_UPSTREAM_HOSTPORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }

  # PWA 설치 파일은 규격 MIME(application/manifest+json)으로 내려야 일부 브라우저에서 설치가 거부되지 않는다
  location = /manifest.webmanifest {
    default_type application/manifest+json;
    add_header Cache-Control "public, max-age=3600";
  }

  # 서비스워커는 캐시되면 새 버전이 안 잡힌다 — 항상 원본 확인
  location = /sw.js {
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location = /readyz {
    access_log off;
    proxy_pass http://${API_UPSTREAM_HOSTPORT}/api/v2/ready;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }
}
